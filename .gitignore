# ============================================================
# AIRA's Diary .gitignore
# 公开仓库配置：严格排除所有敏感配置、运行时数据与构建产物
# ============================================================

# ---------- 敏感配置 ----------
# .env 含真实 API 密钥（DeepSeek / Serper），必须排除
.env
.env.local
.env.*.local
**/.env

# ---------- 依赖 ----------
node_modules/
**/node_modules/

# ---------- 构建产物 ----------
frontend/dist/
**/dist/

# ---------- 运行时数据 ----------
# SQLite 数据库与用户灵感数据
backend/data/
# 用户上传的图片
backend/uploads/

# ---------- 模型缓存 ----------
# embedding 模型（几百 MB，首次运行自动下载）
backend/.cache/
#这里保留了模型本体，删除了拷贝

# ---------- 日志文件 ----------
*.log
*.out.log
*.err.log
server.out.log
server.err.log
vite.out.log
vite.err.log

# ---------- 备份文件 ----------
*.bak
*.db.bak

# ---------- IDE 配置 ----------
.trae/
.vscode/
.idea/

# ---------- 操作系统文件 ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- 临时测试文件 ----------
test_*.json
__test_*
test-*.mjs

# ---------- 调试文件 ----------
debug-*.log
