# AIRA's Diary 后端环境变量示例
# 复制为 .env 并根据需要修改
# AIRA's Diary 后端环境变量（实际配置，请勿提交到版本库）

# 服务器监听端口
PORT=3001

# SQLite 数据库文件路径（相对于 backend 目录）
DB_PATH=./data/inspireflow.db

# 数据目录（存储数据库文件与 per-inspiration JSON 文件）
DATA_DIR=./data

# ============================================================
# 全局默认配置（所有 Agent 共用的兜底值，per-agent 未设置时回退到此）
# ============================================================

# 全局 API 密钥（必填，per-agent 未单独覆盖时使用此 key）
OPENAI_API_KEY=
# 全局 API 基础地址（用于代理或兼容 OpenAI 协议的第三方服务）
OPENAI_BASE_URL=

# 全局默认模型与温度（per-agent 未单独覆盖时使用）
OPENAI_DEFAULT_MODEL=
OPENAI_DEFAULT_TEMPERATURE=0.5

# ============================================================
# 按 Agent 独立配置（覆盖全局默认，每个字段都可单独留空）
# 命名约定：OPENAI_<FIELD>_<AGENT>，AGENT 为 CRYSTALLIZE / EPITAXY / COALESCE
# 字段：API_KEY / BASE_URL / MODEL / TEMP
# 留空或不写则回退到全局默认
# 场景示例：Crystallize 用 Pro 推理模型，Epitaxy 用 Flash 快速生成，Coalesce 用其他服务商
# ============================================================

# ---------- Crystallize（结晶：感知类型 → 定制化追问 → 生成结晶体）----------
# 推荐：推理类任务，用强模型 + 低温度
OPENAI_API_KEY_CRYSTALLIZE=
OPENAI_BASE_URL_CRYSTALLIZE=
OPENAI_MODEL_CRYSTALLIZE=
OPENAI_TEMP_CRYSTALLIZE=

# ---------- Epitaxy（外延：方向提案 → 深挖笔记 → 选词提炼）----------
# 推荐：创意+严谨类任务，用中温度
OPENAI_API_KEY_EPITAXY=
OPENAI_BASE_URL_EPITAXY=
OPENAI_MODEL_EPITAXY=
OPENAI_TEMP_EPITAXY=

# ---------- Coalesce（融合：跨灵感桥梁 → 新灵感种子）----------
# 推荐：联想类任务，用高温度
OPENAI_API_KEY_COALESCE=
OPENAI_BASE_URL_COALESCE=
OPENAI_MODEL_COALESCE=
OPENAI_TEMP_COALESCE=

# ---------- Conversation（v7 追加条目对话：基于灵感上下文回答用户追问）----------
# 推荐：对话类任务，中温度；需支持 function calling 的模型
OPENAI_API_KEY_CONVERSATION=
OPENAI_BASE_URL_CONVERSATION=
OPENAI_MODEL_CONVERSATION=
OPENAI_TEMP_CONVERSATION=

# ---------- Vision（v11 多模态扩展：图片识图，需多模态视觉模型）----------
# 推荐：视觉模型，低温保证客观描述；如 GLM-4V / GPT-4o 等支持 image_url 的模型
OPENAI_API_KEY_VISION=
OPENAI_BASE_URL_VISION=
OPENAI_MODEL_VISION=glm-4v-flash
OPENAI_TEMP_VISION=0.3

# ---------- Distill（v11 多模态扩展：多文件提炼 title+content）----------
# 推荐：文本模型，低温保证基于原文；留空则复用全局 DeepSeek 配置
OPENAI_API_KEY_DISTILL=
OPENAI_BASE_URL_DISTILL=
OPENAI_MODEL_DISTILL=
OPENAI_TEMP_DISTILL=0.3

# ============================================================
# 联网搜索配置（v7 追加条目对话专用）
# ============================================================

# Serper API 密钥（用于追加条目对话的联网搜索功能）
# 获取地址：https://serper.dev
# 留空时对话功能照常运行，但不会触发联网搜索
SERPER_API_KEY=
